local SAVE_FILE = "KingOS_theme.txt"
local currentTheme = "Purple"
pcall(function()
	if isfile and readfile and isfile(SAVE_FILE) then
		local saved = readfile(SAVE_FILE)
		if THEMES[saved] then
			currentTheme = saved
		end
	end
end)
local T = THEMES[currentTheme]

-- Every themed element registers a function here; applying a theme re-runs them all.
local binders = {}
local function refreshAll()
	for _, fn in ipairs(binders) do
		pcall(fn)
	end
end
local function bind(fn)
	pcall(fn)
	table.insert(binders, fn)
end
local function applyTheme(name)
	if not THEMES[name] then return end
	currentTheme = name
	T = THEMES[name]
	pcall(function()
		if writefile then
			writefile(SAVE_FILE, name)
		end
	end)
	refreshAll()
end

-- ====================== HELPERS ======================
local conns = {}
local function track(c)
	table.insert(conns, c)
	return c
end

local function new(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do
		o[k] = v
	end
	if parent then
		o.Parent = parent
	end
	return o
end

local function corner(p, r)
	return new("UICorner", { CornerRadius = UDim.new(0, r or 8) }, p)
end

local function stroke(p, th)
	return new("UIStroke", { Thickness = th or 1.2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, p)
end

local orderCounter = 0
local function nextOrder()
	orderCounter += 1
	return orderCounter
end

local function isPointer(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch
end

