-- Botones bonitos
local function makeButton(text, y)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1, 0, 0, 52)
	b.Position = UDim2.new(0, 0, 0, y)
	b.BackgroundColor3 = BG2
	b.Text = text
	b.TextColor3 = TEXT
	b.Font = Enum.Font.GothamMedium
	b.TextSize = 17
	b.AutoButtonColor = false
	b.Parent = jugadorFrame

	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 11)

	local s = Instance.new("UIStroke", b)
	s.Color = Color3.fromRGB(60, 60, 85)
	s.Thickness = 1.2

	-- Efecto hover
	b.MouseEnter:Connect(function()
		TweenService:Create(b, TweenInfo.new(0.18), {BackgroundColor3 = Color3.fromRGB(40, 40, 60)}):Play()
		TweenService:Create(s, TweenInfo.new(0.18), {Color = PRIMARY}):Play()
	end)
	b.MouseLeave:Connect(function()
		TweenService:Create(b, TweenInfo.new(0.18), {BackgroundColor3 = BG2}):Play()
		TweenService:Create(s, TweenInfo.new(0.18), {Color = Color3.fromRGB(60, 60, 85)}):Play()
	end)

	return b
end

