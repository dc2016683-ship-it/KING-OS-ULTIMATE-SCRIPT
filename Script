	fade.Completed:Wait()
	introFrame:Destroy()

	mainPanel.Visible = true
	mainPanel.BackgroundTransparency = 1
	TweenService:Create(mainPanel, TweenInfo.new(0.5), {BackgroundTransparency = 0}):Play()
end)

