-- ====================== ARRASTRAR PANEL ======================
local dragging = false
local dragStart, startPos

topBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = mainPanel.Position
	end
end)

topBar.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = false
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - dragStart
		mainPanel.Position = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset + delta.Y
		)
	end
end)

-- ====================== EFECTO POLVITO ======================
local function dust(parent, pos)
	local p = Instance.new("Frame")
	p.Size = UDim2.new(0, math.random(5, 12), 0, math.random(5, 12))
	p.Position = pos
	p.BackgroundColor3 = Color3.fromRGB(math.random(160, 255), math.random(100, 200), math.random(220, 255))
	p.BorderSizePixel = 0
	p.BackgroundTransparency = 0.1
	p.Parent = parent
	Instance.new("UICorner", p).CornerRadius = UDim.new(1, 0)

	local goal = {
		Position = UDim2.new(pos.X.Scale + (math.random() - 0.5) * 0.75, 0, pos.Y.Scale + (math.random() - 0.5) * 0.6, 0),
		BackgroundTransparency = 1,
		Size = UDim2.new(0, 2, 0, 2)
	}
	local tw = TweenService:Create(p, TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), goal)
	tw:Play()
	tw.Completed:Connect(function() p:Destroy() end)
end

task.spawn(function()
	task.wait(5)

	for i = 1, 45 do
		dust(introFrame, UDim2.new(0.1 + math.random() * 0.8, 0, 0.3 + math.random() * 0.4, 0))
	end

	local fade = TweenService:Create(introLabel, TweenInfo.new(0.8), {
