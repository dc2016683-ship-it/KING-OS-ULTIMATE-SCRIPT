local function dust(parent, pos)
	local p = new("Frame", {
		Size = UDim2.new(0, math.random(5, 12), 0, math.random(5, 12)),
		Position = pos,
		BackgroundColor3 = T.accent:Lerp(Color3.new(1, 1, 1), math.random() * 0.6),
		BorderSizePixel = 0,
		BackgroundTransparency = 0.1,
	}, parent)
	corner(p, 6)
	local tw = TweenService:Create(p, TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Position = UDim2.new(pos.X.Scale + (math.random() - 0.5) * 0.75, 0, pos.Y.Scale + (math.random() - 0.5) * 0.6, 0),
		BackgroundTransparency = 1,
		Size = UDim2.new(0, 2, 0, 2),
	})
	tw:Play()
	tw.Completed:Connect(function() p:Destroy() end)
end

